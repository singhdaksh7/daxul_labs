# ==================================================
# DAXUL LABS — Production Environment Configuration
# ==================================================

# --------------------------------------------------
# SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER)
# --------------------------------------------------

# 1. PostgreSQL Database Credentials
POSTGRES_USER=daxul_prod_user
POSTGRES_PASSWORD=your_super_strong_postgres_password_2026
POSTGRES_DB=daxul_labs_production
DATABASE_URL=postgresql://daxul_prod_user:your_super_strong_postgres_password_2026@postgres:5432/daxul_labs_production?schema=public

# 2. NextAuth / Auth Session Security
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_secret_here_using_openssl_rand_hex_32

# 3. Initial Super Admin Bootstrap Credentials (REMOVE FROM .ENV AFTER SEEDING)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=StrongAdminPassword2026!

# 4. Razorpay Payment Gateway Server Secrets
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 5. Local Storage & Path Security
STORAGE_PROVIDER=local
STORAGE_PATH=/app/uploads
STORAGE_PUBLIC_URL_PREFIX=/api/uploads/file

# 6. S3-compatible object storage (Cloudflare R2 / MinIO / AWS S3)
#    Used when STORAGE_PROVIDER=r2 | s3 | minio. Keep the bucket PRIVATE (no public access, no r2.dev URL).
#    R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (S3_REGION=auto)
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --------------------------------------------------
# PUBLIC ENVIRONMENT VARIABLES (SAFE FOR BROWSER)
# --------------------------------------------------
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
