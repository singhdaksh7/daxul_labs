generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  percentage
  fixed
}

enum ManufacturingStatus {
  new
  design_pending
  design_approved
  printing
  finishing
  qc
  packed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  prepaid
  cod
}

enum PaymentStatus {
  paid
  pending
  failed
}

model User {
  id                      String         @id @default(cuid())
  name                    String?
  email                   String         @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  role                    Role           @default(CUSTOMER)
  phone                   String?
  notificationPreferences Json?
  addresses               Address[]
  orders                  Order[]
  wishlist                WishlistItem[]
  accounts                Account[]
  sessions                Session[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  category              String
  price                 Float
  compareAtPrice        Float?
  description           String        @db.Text
  story                 String?       @db.Text
  specs                 Json?         // Array of { label, value }
  careInstructions      String[]
  faq                   Json?         // Array of { question, answer }
  images                String[]
  videoUrl              String?
  badge                 String?
  stock                 Int           @default(10)
  productionTimeDays   Int           @default(2)
  estimatedDispatchDays Int           @default(3)
  prepaidOnly           Boolean       @default(false)
  codEnabled            Boolean       @default(true)
  finishes              String[]
  colors                String[]
  sizes                 String[]
  businessCosts         Json?         // { filamentGrams, printHours, filamentCostPerGram, hardwareCost, packagingCost, otherMaterialCost }
  isArchived            Boolean       @default(false)
  isFeatured            Boolean       @default(false)
  subtitle              String?
  sku                   String?       @unique
  isActive              Boolean       @default(true)
  customizable          Boolean       @default(false)
  trackInventory        Boolean       @default(true)
  lowStockThreshold     Int           @default(3)
  damagedStock          Int           @default(0)
  incomingStock         Int           @default(0)
  seoTitle              String?
  seoDescription        String?       @db.Text
  ogImage               String?
  materials             String?       @db.Text
  dimensions            String?
  leadTimeText          String?
  collectionId          String?
  collection            Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  variantGroups         ProductVariantGroup[]
  inventoryAdjustments  InventoryAdjustment[]
  customFields          CustomField[]
  orderItems            OrderItem[]
  wishlistItems         WishlistItem[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model CustomField {
  id          String   @id @default(cuid())
  productId   String
  label       String
  type        String   // text, textarea, photo, date, color, select
  required    Boolean  @default(false)
  options     String[]
  fee         Float    @default(0)
  placeholder String?
  helpText    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  choices     Json?    // Array of { label, value, priceAdjustment } for select/radio
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ProductVariantGroup {
  id        String           @id @default(cuid())
  productId String
  name      String           // e.g. Size, Color, Light Temperature
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]
}

model ProductVariant {
  id              String              @id @default(cuid())
  groupId         String
  name            String
  sku             String?
  priceAdjustment Float               @default(0)
  stock           Int?                // null = not tracked separately
  damagedStock    Int                 @default(0)
  incomingStock   Int                 @default(0)
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  group           ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inventoryAdjustments InventoryAdjustment[]
}

model InventoryAdjustment {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  delta         Int
  quantityAfter Int
  reason        String          // production_added, damaged, correction, returned, manual, order
  note          String?
  adminUserId   String?
  adminEmail    String?
  createdAt     DateTime        @default(now())
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model StorePolicy {
  slug      String   @id            // shipping, returns, cancellation, privacy, terms
  title     String
  content   String   @db.Text       // restricted markdown, rendered without raw HTML
  updatedAt DateTime @updatedAt
}


model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  image       String
  badge       String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  heroMedia   String?
  seoTitle    String?
  seoDescription String? @db.Text
  ogImage     String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userId             String?
  customer           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String
  street             String
  city               String
  state              String
  pincode            String
  country            String              @default("India")
  totalAmount        Float
  discountAmount     Float               @default(0)
  shippingFee        Float               @default(0)
  codFee             Float               @default(0)
  paymentMethod      PaymentMethod       @default(prepaid)
  paymentStatus      PaymentStatus       @default(pending)
  razorpayOrderId    String?             @unique
  razorpayPaymentId  String?             @unique
  razorpaySignature  String?
  status             ManufacturingStatus @default(new)
  qcNotes            String?             @db.Text
  trackingNumber     String?
  courierName        String?
  proofImageUrl      String?
  trackingUrl        String?
  shippingMethod     String              @default("STANDARD")
  reservationExpiresAt DateTime?
  stockReleasedAt    DateTime?
  internalNotes      String?             @db.Text
  couponCode         String?
  cancellationReason     String?
  cancelledAt            DateTime?
  cancellationRequested  Boolean             @default(false)
  cancellationRequestedAt DateTime?
  refundStatus           String?             @default("none")
  refundedAmount         Float               @default(0)
  designProofUrl         String?
  designStatus           String              @default("pending") // pending, proof_uploaded, approved, changes_requested
  designNotes            String?
  designFeedback         String?
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  jobTickets             ProductionJobTicket[]
  refunds                OrderRefund[]
  paymentTransactions    PaymentTransaction[]

  @@index([customerEmail])
  @@index([userId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  productImage    String
  unitPrice       Float
  quantity        Int
  selectedFinish  String?
  selectedColor   String?
  selectedSize    String?
  customizations  Json?    // Key-value pairs of customer inputs
  customizationFee Float   @default(0)
  variantSelections Json?  // Array of { group, variant, sku, priceAdjustment } snapshot
  productSku      String?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  jobTickets      ProductionJobTicket[]
}

model OrderStatusHistory {
  id        String              @id @default(cuid())
  orderId   String
  status    ManufacturingStatus
  timestamp DateTime            @default(now())
  note      String?
  adminEmail String?
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Legacy pre-CMS table, preserved for safety. Unused by the app; to be dropped in a later cleanup migration.
model HomepageSectionLegacy {
  id               String   @id @default(cuid())
  type             String
  title            String
  subtitle         String
  badgeText        String
  content          String   @db.Text
  ctaText          String
  ctaUrl           String
  secondaryCtaText String?
  secondaryCtaUrl  String?
  mediaUrl         String
  secondaryMediaUrl String?
  isVisible        Boolean  @default(true)
  order            Int      @default(0)
}

model HomepageSection {
  id               String   @id @default(cuid())
  sectionKey       String   @unique
  sectionType      String   // HEADER, HERO, FEATURED_PRODUCT, COLLECTIONS, CUSTOMIZATION, LAB, BUILDING_DAXUL, FOOTER
  name             String
  visible          Boolean  @default(true)
  sortOrder        Int      @default(0)
  draftContent     Json
  publishedContent Json
  draftSettings    Json?
  publishedSettings Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  type       String   // image, video
  storageKey String   @unique
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  duration   Float?
  altText    String?
  caption    String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CmsAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminEmail  String?
  sectionKey  String?
  action      String
  details     Json?
  createdAt   DateTime @default(now())
}

model ThemeSettings {
  id                    String @id @default("default")
  backgroundColor       String @default("#0B0B0C")
  cardBackgroundColor   String @default("#151515")
  accentColor           String @default("#C8FF35")
  textColor             String @default("#FFFFFF")
  secondaryTextColor    String @default("#B9B9B4")
  buttonColor           String @default("#C8FF35")
  buttonTextColor       String @default("#0B0B0C")
  fontFamily            String @default("var(--font-geist-sans), sans-serif")
  headingSizeMultiplier Float  @default(1.0)
  borderRadius          String @default("md")
  cardStyle             String @default("glass")
  carbonColor           String @default("#0B0B0C")
  boneColor             String @default("#F3F0E9")
  graphiteColor         String @default("#242426")
  buttonRadius          String @default("md")
}

model SiteSettings {
  id                       String  @id @default("default")
  announcementBarText      String  @default("ON-DEMAND PRODUCTION • FREE SHIPPING ON ORDERS OVER ₹1999")
  announcementBarEnabled   Boolean @default(true)
  brandName                String  @default("DAXUL LABS")
  brandTagline             String  @default("Objects Made Differently.")
  brandDescription         String  @db.Text
  contactEmail             String  @default("studio@daxullabs.com")
  contactPhone             String  @default("+91 98765 43210")
  whatsAppNumber           String  @default("+919876543210")
  instagramUrl             String  @default("https://instagram.com/daxullabs")
  footerText               String  @default("© 2026 DAXUL LABS. CRAFTED ON-DEMAND IN INDIA.")
  standardShippingFee      Float   @default(99)
  expressShippingFee       Float   @default(199)
  freeShippingThreshold    Float   @default(1999)
  codFee                   Float   @default(50)
  globalCodEnabled         Boolean @default(true)
  currencySymbol           String  @default("₹")
  currencyCode             String  @default("INR")
  whatsAppUrl              String?
  standardShippingEnabled  Boolean @default(true)
  expressShippingEnabled   Boolean @default(false)
  reservationMinutes       Int     @default(60)
  youtubeUrl               String?
  facebookUrl              String?
  instagramHandle          String  @default("daxullabs")
  businessAddress          String? @db.Text
  supportHours             String?
  orderPrefix              String  @default("DXL")
  codFeeEnabled            Boolean @default(true)
  customProductsPrepaidOnly Boolean @default(true)
  gstEnabled               Boolean @default(false)
  gstNumber                String?
  defaultOgImage           String?
  searchIndexingEnabled    Boolean @default(true)
  seoTitle                 String  @default("DAXUL LABS | Designed 3D Printed Objects & Projection Lamps")
  seoDescription           String  @db.Text
  shippingPolicyText       String  @db.Text
  returnPolicyText         String  @db.Text
  privacyPolicyText        String  @db.Text
  termsConditionsText      String  @db.Text
  cancellationPolicyText   String  @db.Text
  customizationStep1Title  String  @default("1. Upload & Input")
  customizationStep1Desc   String  @default("Upload a portrait photo, logo, or enter custom names and dates.")
  customizationStep2Title  String  @default("2. 3D Design Proof")
  customizationStep2Desc   String  @default("Our studio generates a 3D light-refracting model proof.")
  customizationStep3Title  String  @default("3. Precision Printing")
  customizationStep3Desc   String  @default("Crafted layer-by-layer using high-density organic biopolymers.")
  customizationStep4Title  String  @default("4. Finishing & Delivery")
  customizationStep4Desc   String  @default("Hand-finished, LED electronics tested, and dispatched to your door.")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType @default(percentage)
  discountValue Float
  minOrderValue Float        @default(0)
  startDate     DateTime?
  expiryDate    DateTime?
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UploadedFile {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int
  provider     String   // local, s3, minio
  path         String
  url          String
  userId       String?
  orderId      String?
  createdAt    DateTime @default(now())
}

model ProcessedWebhook {
  id        String   @id
  event     String
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  adminUserId    String?
  adminUserEmail String
  action         String
  entityType     String
  entityId       String?
  details        Json?
  timestamp      DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailKey  String   // normalized email (lowercased, trimmed) or sha256 of it
  ipKey     String   // client IP (or "unknown")
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([emailKey, ipKey, createdAt])
  @@index([ipKey, createdAt])
  @@index([createdAt])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsPage {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  parentPageId    String?
  parentPage      CmsPage?           @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages      CmsPage[]          @relation("PageHierarchy")
  isSystem        Boolean            @default(false)
  status          PageStatus         @default(DRAFT)
  sortOrder       Int                @default(0)
  seoTitle        String?
  seoDescription  String?            @db.Text
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean            @default(false)
  sections        PageSection[]
  redirects       CmsRedirect[]
  versionHistory  CmsVersionHistory[]
  navigationItems NavigationItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([slug])
  @@index([status])
  @@index([sortOrder])
}

model PageSection {
  id               String   @id @default(cuid())
  pageId           String
  page             CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type             String   // HERO, BANNER, TEXT, IMAGE_TEXT, PRODUCT_GRID, COLLECTION_GRID, FEATURED_PRODUCT, GALLERY, VIDEO, CTA, STATS, TABS, FAQ, TESTIMONIALS, CUSTOMIZATION, BRAND_STATEMENT, INSTAGRAM, NEWSLETTER, CONTACT, SPACER
  name             String?
  sortOrder        Int      @default(0)
  visible          Boolean  @default(true)
  draftContent     Json
  publishedContent Json
  settings         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([pageId, sortOrder])
  @@index([pageId, visible])
}

model NavigationMenu {
  id        String           @id @default(cuid())
  handle    String           @unique // "header", "footer", "mobile"
  name      String
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id         String          @id @default(cuid())
  menuId     String
  menu       NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     NavigationItem? @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   NavigationItem[] @relation("MenuHierarchy")
  label      String
  url        String
  pageId     String?
  page       CmsPage?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  openNewTab Boolean         @default(false)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([menuId, sortOrder])
}

model CmsRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  pageId     String?
  page       CmsPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("NEW") // NEW, READ, RESPONDED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Banner {
  id                  String    @id @default(cuid())
  name                String
  placement           String    @default("ANNOUNCEMENT") // ANNOUNCEMENT, HOMEPAGE_HERO, PROMO_BAR, PAGE_HERO
  text                String    // Primary text / fallback title
  eyebrow             String?
  headline            String?
  subheadline         String?
  body                String?   @db.Text
  buttonText          String?   // Primary CTA label
  linkUrl             String?   // Primary CTA link
  secondaryCtaLabel   String?
  secondaryCtaUrl     String?
  desktopImage        String?
  mobileImage         String?
  videoUrl            String?
  desktopImageMediaId String?
  mobileImageMediaId  String?
  videoMediaId        String?
  textAlign           String    @default("left") // left, center, right
  textMode            String    @default("dark") // dark, light
  overlay             Boolean   @default(false)
  status              String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  startDate           DateTime?
  endDate             DateTime?
  priority            Int       @default(0)
  visible             Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([placement, visible, priority])
  @@index([placement, status, visible])
}

model CmsVersionHistory {
  id         String   @id @default(cuid())
  pageId     String
  page       CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  adminEmail String
  action     String   // PUBLISH, REVERT, DRAFT_SAVE
  snapshot   Json
  createdAt  DateTime @default(now())

  @@index([pageId, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model OrderRefund {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount             Float
  gatewayRefundId    String?
  reason             String
  status             String   @default("completed") // pending, completed, failed
  adminEmail         String
  restockedInventory Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([orderId])
}

model PaymentTransaction {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String   @default("razorpay")
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Float
  currency         String   @default("INR")
  status           String   // created, authorized, captured, failed, refunded
  method           String?  // card, upi, netbanking, wallet
  errorDescription String?
  isReconciled     Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([gatewayPaymentId])
  @@index([gatewayOrderId])
  @@index([status])
}

model AbandonedCheckout {
  id               String    @id @default(cuid())
  cartId           String    @unique
  email            String?
  phone            String?
  customerName     String?
  items            Json
  subtotal         Float     @default(0)
  estimatedTotal   Float     @default(0)
  currentStep      String    @default("contact") // contact, shipping, payment
  convertedOrderId String?
  isRecovered      Boolean   @default(false)
  recoveryToken    String    @unique @default(cuid())
  lastNotifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isRecovered, createdAt])
  @@index([email])
}

model Printer {
  id        String                @id @default(cuid())
  name      String
  model     String
  status    String                @default("AVAILABLE") // AVAILABLE, PRINTING, MAINTENANCE, OFFLINE
  location  String?
  notes     String?
  tickets   ProductionJobTicket[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ProductionJobTicket {
  id                       String    @id @default(cuid())
  ticketNumber             String    @unique
  orderId                  String
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId              String
  orderItem                OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  printerId                String?
  printer                  Printer?  @relation(fields: [printerId], references: [id], onDelete: SetNull)
  material                 String?
  color                    String?
  designFileUrl            String?
  estimatedGrams           Float?
  actualGrams              Float?
  estimatedDurationMinutes Int?
  actualDurationMinutes    Int?
  operator                 String?
  status                   String    @default("QUEUED") // QUEUED, PRINTING, FAILED, REPRINT, FINISHING, QC, DONE
  failureReason            String?
  qcChecklist              Json?
  qcNotes                  String?   @db.Text
  startTime                DateTime?
  endTime                  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status])
  @@index([orderId])
}

model NotificationLog {
  id         String   @id @default(cuid())
  channel    String   // email, whatsapp, sms
  recipient  String
  event      String   // order_confirmed, payment_received, proof_ready, shipped, etc.
  template   String
  status     String   // sent, failed, simulated
  providerId String?
  error      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([recipient, createdAt])
  @@index([event, status])
}


